# Base de données : SQLite par défaut ; PostgreSQL :
# DATABASE_URL=postgresql+psycopg://dayone:dayone@localhost:5432/dayone
DATABASE_URL=sqlite:///./data/dayone.db

# WhatsApp Cloud API (Meta for Developers > votre app > WhatsApp > API Setup)
WHATSAPP_VERIFY_TOKEN=un-jeton-long-et-aleatoire
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_API_VERSION=v21.0
WHATSAPP_SKIP_SIGNATURE=false
# Aperçu (bande de photo, identités masquées) joint aux questions de vérification
WHATSAPP_APERCUS=true

# Stockage chiffré des images : python scripts/gen_key.py
STORAGE_DIR=./data/images
STORAGE_ENCRYPTION_KEY=

SESSION_WINDOW_SECONDS=900
WORKER_INTERVAL_SECONDS=20

# Cerveau IA local (Ollama : https://ollama.com ; ollama pull qwen2.5vl:3b)
AI_ENABLED=true
OLLAMA_URL=http://localhost:11434
AI_MODEL_MAIN=qwen2.5vl:3b
# 2e avis sur les champs critiques/douteux (même modèle par défaut ; qwen2.5vl:7b si VRAM >= 6 Go ; vide = désactivé)
AI_MODEL_VERIFY=qwen2.5vl:3b
AI_SEUIL_CONNU=0.8
# Contexte Ollama ; 4096 si le modèle déborde de la VRAM (plus rapide sur 4 Go)
AI_NUM_CTX=8192
# Plafond de tokens générés par appel : un modèle qui boucle ne bloque pas la file
AI_NUM_PREDICT=2048
